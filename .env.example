# Copy to .env.local. Use ONLY your own database and keys.
NEXT_PUBLIC_APP_NAME="Competitive Intelligence"
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-own-publishable-or-anon-key
# Optional external services. Disabled or unavailable until you configure them.
ENABLE_NEWS_FETCH=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
NEXT_TELEMETRY_DISABLED=1
